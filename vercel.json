{
  "version": 2,
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/cleanremoto.py",
      "headers": {
        "Content-Type": "text/x-python; charset=utf-8",
        "Content-Disposition": "attachment; filename=\"cleanremoto.py\""
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
